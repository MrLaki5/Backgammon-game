<?xml version="1.0" encoding="utf-8"?>
<!--
    One shop product.

    The card itself is the rarity: bronze, silver, turquoise glaze or gold, cast
    as a metal frame around a quiet wood field, and the medallion mounted on it
    is struck in that same metal. A legendary item is gold all the way through
    rather than labelled legendary, which is what makes the shelf readable at a
    glance — and readable in this game's terms rather than a stock palette's.

    The background is set in code (ShopArt.card) because rarity is data.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_xs">

    <LinearLayout
        android:id="@+id/shopCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_common"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <View
            android:id="@+id/viewRarityBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="@dimen/art_md"
            android:layout_height="@dimen/art_md">

            <TextView
                android:id="@+id/tvShopItemIcon"
                android:layout_width="@dimen/art_md"
                android:layout_height="@dimen/art_md"
                android:background="@drawable/medal_shop_common"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvShopItemQuantityBadge"
                style="@style/RoyalText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:textSize="@dimen/text_micro"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvShopItemRarity"
            style="@style/RoyalText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.06"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/tvShopItemTitle"
            style="@style/RoyalText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvShopItemDesc"
            style="@style/RoyalText.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/text_micro" />

        <LinearLayout
            android:id="@+id/layoutShopItemUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivShopItemLock"
                android:layout_width="@dimen/space_m"
                android:layout_height="@dimen/space_m"
                android:contentDescription="@null"
                android:src="@drawable/gold_lock" />

            <TextView
                android:id="@+id/tvShopItemUnlock"
                style="@style/RoyalText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:gravity="center"
                android:textColor="@color/terracotta"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/shopItemUnlockProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xs"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_track_royal"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnShopItemAction"
            style="@style/RoyalButton.Gold"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_sm"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:textSize="@dimen/text_micro" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvShopItemBadge"
        style="@style/RoyalText.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_xs"
        android:background="@drawable/bg_chip_turquoise"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:textColor="@color/turquoise"
        android:textSize="@dimen/text_micro"
        android:visibility="gone" />
</FrameLayout>
