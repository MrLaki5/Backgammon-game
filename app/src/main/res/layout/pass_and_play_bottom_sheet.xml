<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pnpSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Title Header + Close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pnpSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pass_and_play_setup"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/pnpCloseButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_close_button"
            android:contentDescription="@string/cancel"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#CFE3EE" />
    </LinearLayout>

    <!-- Theme Grid: single row of 8 compact 52dp thumbnails -->
    <LinearLayout
        android:id="@+id/pnpThemeGridContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Theme 0: Royal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb0"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_selected"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/pnpThemeImg0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_royal"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 1: Pop Art -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/pnpThemeImg1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_pop_art"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 2: Cyberpunk -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/pnpThemeImg2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_cyberpunk"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 3: Luxury -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/pnpThemeImg3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_luxury"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 4: Woodland -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_woodland" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_woodland_name"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 5: Galaxy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_galaxy" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_galaxy"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 6: Ancient Egypt -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb6"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_egypt" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_ancient_egypt"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Theme 7: Neon Retro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pnpThemeThumb7"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_neon" />
                <LinearLayout
                    android:id="@+id/pnpLockOverlay7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pnpThemeLabel7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/theme_neon_retro"
                android:textColor="@color/color_player_name_text"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Variant & match length -->
    <include layout="@layout/include_variant_picker" />

    <!-- Player Names Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/pnpName1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_name_field_normal"
            android:fontFamily="@font/vazirmatn_semibold"
            android:gravity="center"
            android:hint="@string/player_one"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="@string/pass_and_play_player1_default"
            android:textColor="@color/color_player_name_text"
            android:textColorHint="@color/color_player_name_hint"
            android:textDirection="rtl"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/pnpName2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_name_field_normal"
            android:fontFamily="@font/vazirmatn_semibold"
            android:gravity="center"
            android:hint="@string/player_two"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="@string/pass_and_play_player2_default"
            android:textColor="@color/color_player_name_text"
            android:textColorHint="@color/color_player_name_hint"
            android:textDirection="rtl"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Play button: full width -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/pnpPlay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_play"
        app:backgroundTint="@null"
        android:fontFamily="@font/vazirmatn_semibold"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/play"
        android:textAllCaps="false"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:elevation="6dp" />
</LinearLayout>
