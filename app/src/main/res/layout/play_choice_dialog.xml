<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:background="@drawable/neuro_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_semibold"
        android:gravity="center"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="@string/play_choice_title"
        android:textColor="@color/accent_gold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/vazirmatn_regular"
        android:gravity="center"
        android:text="@string/play_choice_message"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/choiceContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/neuro_secondary_button"
        android:elevation="0dp"
        android:fontFamily="@font/vazirmatn_semibold"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/continue_game"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/choiceNewGame"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/neuro_primary_button"
        android:elevation="0dp"
        android:fontFamily="@font/vazirmatn_semibold"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/new_game"
        android:textAllCaps="false"
        android:textColor="@color/surface_base"
        android:textSize="19sp"
        android:textStyle="bold" />

</LinearLayout>
