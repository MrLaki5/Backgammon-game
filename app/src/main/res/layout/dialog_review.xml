<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pause_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/review_title"
        android:textColor="@color/accent_gold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/review_message"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/reviewYes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_roll_dice_amber"
        android:text="@string/review_rate"
        android:textAllCaps="false"
        android:textColor="#FF1B1B2F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/reviewLater"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pause_button"
        android:text="@string/review_later"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/reviewNever"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:text="@string/review_never"
        android:textAllCaps="false"
        android:textColor="#77FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
