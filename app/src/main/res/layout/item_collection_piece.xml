<?xml version="1.0" encoding="utf-8"?>
<!--
    One piece in the treasury.

    Three states, and the middle one is the reason this screen exists: held,
    still on sale, or closed and never held. A collection is only worth looking
    at if it can show you what you missed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/card_shop_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_s"
    android:background="@drawable/card_common"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_s"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <FrameLayout
        android:layout_width="@dimen/art_lg"
        android:layout_height="@dimen/art_lg">

        <ImageView
            android:id="@+id/pieceArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <!-- The seal only appears on something actually held. -->
        <ImageView
            android:id="@+id/pieceSeal"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pieceLock"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/gold_lock"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/pieceName"
        style="@style/RoyalText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/pieceState"
        style="@style/RoyalText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/text_micro" />
</LinearLayout>
