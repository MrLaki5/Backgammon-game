<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pause_dialog"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <!-- ===== HEADER ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_semibold"
        android:gravity="center"
        android:text="@string/player_setup"
        android:textColor="#E6A100"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="#33E6A100" />

    <!-- ===== PLAYER CARDS ROW ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Player 1 Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/neuro_inset_field"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_semibold"
                android:gravity="center"
                android:text="@string/player_one"
                android:textColor="#E6A100"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dialogPName1"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/neuro_inset_field"
                android:fontFamily="@font/vazirmatn_regular"
                android:hint="@string/player_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:text="@string/player_one"
                android:textColor="#E0E0E0"
                android:textColorHint="#666666"
                android:textDirection="rtl"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/dialogRadioGP1"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/neuro_inset_field"
                android:checkedButton="@id/radioButton"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/radioButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_toggle_button"
                    android:button="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:text="@string/human_player"
                    android:textColor="@color/segmented_toggle_text"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/radioButton2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_toggle_button"
                    android:button="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:text="@string/bot_player"
                    android:textColor="@color/segmented_toggle_text"
                    android:textSize="13sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Player 2 Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/neuro_inset_field"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_semibold"
                android:gravity="center"
                android:text="@string/player_two"
                android:textColor="#E6A100"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dialogPName2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/neuro_inset_field"
                android:fontFamily="@font/vazirmatn_regular"
                android:hint="@string/player_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:text="@string/bot_player"
                android:textColor="#E0E0E0"
                android:textColorHint="#666666"
                android:textDirection="rtl"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/dialogRadioGP2"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/neuro_inset_field"
                android:checkedButton="@id/radioButton4"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/radioButton3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_toggle_button"
                    android:button="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:text="@string/human_player"
                    android:textColor="@color/segmented_toggle_text"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/radioButton4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_toggle_button"
                    android:button="@null"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:text="@string/bot_player"
                    android:textColor="@color/segmented_toggle_text"
                    android:textSize="13sp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== SETTINGS SECTION ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#33E6A100" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/vazirmatn_semibold"
        android:gravity="center"
        android:text="@string/bot_board_settings"
        android:textColor="#99AAB5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Bot Difficulty + Board Theme — side by side, compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Bot Difficulty -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/neuro_inset_field"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_semibold"
                android:gravity="center"
                android:text="@string/bot_difficulty"
                android:textColor="#E6A100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/dialogBotDifficulty"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/neuro_inset_field"
                android:entries="@array/bot_difficulty_entries"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:popupBackground="#1E3347" />
        </LinearLayout>

        <!-- Board Theme -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/neuro_inset_field"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_semibold"
                android:gravity="center"
                android:text="@string/board_theme"
                android:textColor="#E6A100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/dialogBoardTheme"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/neuro_inset_field"
                android:entries="@array/board_theme_entries"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:popupBackground="#1E3347" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== ACTION BUTTONS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pause_button"
            android:fontFamily="@font/vazirmatn_semibold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dialogPlay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.5"
            android:background="@drawable/neuro_primary_button"
            android:fontFamily="@font/vazirmatn_semibold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/play"
            android:textAllCaps="false"
            android:textColor="#0E1721"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
