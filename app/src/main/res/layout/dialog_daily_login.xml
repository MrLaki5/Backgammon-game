<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dlgTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lalezar_regular"
        android:text="@string/daily_login_title"
        android:textColor="@color/color_gold_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/dlgDayRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Day 1 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 5 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 6 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Day 7 -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/shape_circle_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/daily_login_day"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dlgCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/color_gold_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dlgOk"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_play"
        android:text="@string/daily_login_claim"
        android:textColor="@color/surface_base"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
