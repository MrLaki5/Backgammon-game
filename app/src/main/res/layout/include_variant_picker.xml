<?xml version="1.0" encoding="utf-8"?>
<!-- Variant / Tavli / match length picker, shared by the vs-bot and pass-and-play sheets -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/variantPicker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/variantStandard"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_standard"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantTavla"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_tavla"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantPortes"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_portes"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantPlakoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_plakoto"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/variantFevga"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_fevga"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantNardy"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_nardy"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantAcey"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_acey"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/variantTavli"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_tavli"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/matchLength"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/match_single"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/variantHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn_regular"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="@color/color_difficulty_text_normal"
        android:textSize="11sp" />
</LinearLayout>
