<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meny_background"
    android:layoutDirection="locale"
    tools:context=".Menus.ScoresActivity">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/royal_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/leaderboard_title"
            android:textColor="@color/accent_gold"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Tab bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/neuro_inset_field"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/tabWeek"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segmented_toggle_button"
                android:fontFamily="@font/vazirmatn_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/leaderboard_this_week"
                android:textAllCaps="false"
                android:textColor="@color/segmented_toggle_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/tabMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/segmented_toggle_button"
                android:fontFamily="@font/vazirmatn_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/leaderboard_this_month"
                android:textAllCaps="false"
                android:textColor="@color/segmented_toggle_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/tabAllTime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/segmented_toggle_button"
                android:fontFamily="@font/vazirmatn_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/leaderboard_all_time"
                android:textAllCaps="false"
                android:textColor="@color/segmented_toggle_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Leaderboard list -->
        <TextView
            android:id="@+id/emptyLeaderboardText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/leaderboard_empty"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/leaderboardList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never" />

        <!-- Legacy scores link -->
        <Button
            android:id="@+id/showLegacyScores"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/royal_secondary_button"
            android:fontFamily="@font/vazirmatn_regular"
            android:onClick="showLegacyScores"
            android:text="@string/leaderboard_legacy_scores"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

    </LinearLayout>
</FrameLayout>
