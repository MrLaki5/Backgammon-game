<?xml version="1.0" encoding="utf-8"?>
<!--
    The bundle page.

    A season was previously a row of small cards with a combined price under
    them, which is a receipt rather than an offer. This is the page the decision
    actually gets made on: the set standing in its niche on the left at the size
    the art was drawn for, and on the right what is in it, what it costs apart,
    what it costs together, and how long is left.

    Landscape, two columns, because every screen in this game is landscape and a
    hero image wants the width.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_royal_backdrop"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xs">

            <ImageButton
                android:id="@+id/btnBundleBack"
                android:layout_width="@dimen/control_md"
                android:layout_height="@dimen/control_md"
                android:background="@drawable/bg_round_button_royal"
                android:contentDescription="@string/review_back"
                android:src="@drawable/gold_back" />

            <TextView
                android:id="@+id/bundleSeasonName"
                style="@style/RoyalText.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_title" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_royal_well"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/gold_coin" />

                <TextView
                    android:id="@+id/bundleCoins"
                    style="@style/RoyalText.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_sm"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ic_arabesque_divider" />

        <!-- Two columns: the set on the left, what it is and costs on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_m">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/bundleHero"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/bundleStory"
                    style="@style/RoyalText.Story"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:maxLines="3"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/bundleDaysLeft"
                    style="@style/RoyalText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_chip_turquoise"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xs"
                    android:textColor="@color/turquoise"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RoyalText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bundle_contents"
                    android:textSize="@dimen/text_body" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/space_xs"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bundleItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <!-- The money, set into the panel rather than floating on it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_royal_well"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/bundleSeparately"
                        style="@style/RoyalText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_micro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/bundleSetPrice"
                            style="@style/RoyalText.Display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/bundleSaving"
                            style="@style/RoyalText.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_turquoise"
                            android:paddingStart="@dimen/space_s"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_s"
                            android:paddingBottom="@dimen/space_xs"
                            android:textColor="@color/turquoise"
                            android:textSize="@dimen/text_micro" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnBundleBuy"
                    style="@style/RoyalButton.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_lg"
                    android:layout_marginTop="@dimen/space_s"
                    android:paddingStart="@dimen/space_s"
                    android:paddingEnd="@dimen/space_s"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
