<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay shown between turns in Pass & Play mode.
     Blocks the board view and waits for "I'm Ready" tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/turnSwitchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6112532"
    android:clickable="true"
    android:elevation="20dp"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/neuro_dialog_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="42dp"
        android:paddingTop="32dp"
        android:paddingEnd="42dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/turnSwitchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_semibold"
            android:text="@string/turn_switch_title"
            android:textColor="@color/accent_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/turnSwitchMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/turnSwitchReady"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/neuro_primary_button"
            android:fontFamily="@font/vazirmatn_semibold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/turn_switch_ready"
            android:textAllCaps="false"
            android:textColor="@color/surface_base"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
