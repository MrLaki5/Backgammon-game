<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/newGameSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_royal_panel"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Title & Player Name Header Row + Close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheetTitle"
            style="@style/RoyalText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_game"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/singlePlayerName"
            android:layout_width="140dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_royal_well"
            android:cursorVisible="true"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:hint="@string/player_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/player_one"
            android:textColor="@color/ink_parchment"
            android:textColorHint="@color/color_player_name_hint"
            android:textDirection="rtl"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/singleCloseButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_close_button"
            android:contentDescription="@string/cancel"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#CFE3EE" />
    </LinearLayout>

    <!-- The boards are the only pictures in this dialog, so they get the space
         to read as pictures: bigger, scrollable, captions you can actually see. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/themeGridContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Theme 0: Royal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_selected"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/themeImg0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_royal"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 1: Pop Art -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/themeImg1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/lockOverlay1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_pop_art"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 2: Cyberpunk -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/themeImg2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/lockOverlay2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_cyberpunk"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 3: Luxury -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/themeImg3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <LinearLayout
                    android:id="@+id/lockOverlay3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_luxury"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 4: Woodland -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_woodland" />
                <LinearLayout
                    android:id="@+id/lockOverlay4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_woodland_name"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 5: Galaxy -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_galaxy" />
                <LinearLayout
                    android:id="@+id/lockOverlay5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_galaxy"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 6: Ancient Egypt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_egypt" />
                <LinearLayout
                    android:id="@+id/lockOverlay6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_ancient_egypt"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Theme 7: Neon Retro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/themeThumb7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_theme_thumb_normal"
                android:padding="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/preview_theme_neon" />
                <LinearLayout
                    android:id="@+id/lockOverlay7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_lock_overlay"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lock_theme" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/themeLabel7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/lalezar_regular"
                android:text="@string/theme_neon_retro"
                android:textColor="@color/ink_parchment"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    </HorizontalScrollView>

    <!-- Variant & match length -->
    <include layout="@layout/include_variant_picker" />

    <!-- Difficulty selector row -->
    <LinearLayout
        android:id="@+id/difficultyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/diffEasy"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_easy"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/diffMedium"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_selected"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_medium"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_selected"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/diffHard"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_hard"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/diffRoyal"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_difficulty_normal"
            app:fontFamily="@font/lalezar_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_royal"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Play button: full width -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/singlePlay"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_gold_button"
        app:backgroundTint="@null"
        app:fontFamily="@font/lalezar_regular"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/play"
        android:textAllCaps="false"
        android:textColor="@color/ink_on_gold"
        android:textSize="19sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:elevation="6dp" />
</LinearLayout>
