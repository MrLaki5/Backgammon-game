    <string name="journey_1_title">Home board</string>
    <string name="journey_1_flavor">Where every player starts: a quiet game and a patient opponent.</string>
    <string name="journey_1_opponent">Uncle Reza</string>
    <string name="journey_2_title">The tea house</string>
    <string name="journey_2_flavor">Three games against the regulars, where speed matters less than steadiness.</string>
    <string name="journey_2_opponent">Master Kazem</string>
    <string name="journey_3_title">Istanbul</string>
    <string name="journey_3_flavor">Tavla, played fast: the starter rolls again and mars is worth two.</string>
    <string name="journey_3_opponent">Emre</string>
    <string name="journey_4_title">Athens</string>
    <string name="journey_4_flavor">Portes, the first game of Tavli, a cousin of the game you know.</string>
    <string name="journey_4_opponent">Nikos</string>
    <string name="journey_5_title">Crete</string>
    <string name="journey_5_flavor">Plakoto: no hitting here, only pinning — and the mother decides everything.</string>
    <string name="journey_5_opponent">Eleni</string>
    <string name="journey_6_title">Thessaloniki</string>
    <string name="journey_6_flavor">Fevga: one checker leads the way until it passes the opponent\'s start.</string>
    <string name="journey_6_opponent">Yannis</string>
    <string name="journey_7_title">By the Caspian</string>
    <string name="journey_7_flavor">Long Nardy: no hitting, one checker per turn off the head, blocks decide the race.</string>
    <string name="journey_7_opponent">Farid</string>
    <string name="journey_9_title">The grand master</string>
    <string name="journey_9_flavor">A full Tavli match: Portes, Plakoto and Fevga against the strongest opponent.</string>
    <string name="journey_9_opponent">The grand master</string>
    <string name="variant_acey">Acey-deucey</string>
    <string name="variant_acey_rules">American style: all checkers start off the board and enter like from the bar. A 1-2 roll adds a double of your choice and another roll. The loser pays a point for every checker still on the board.</string>
    <string name="acey_bonus_title">Name a double</string>
    <string name="acey_bonus_option">Double %1$d</string>
    <string name="journey_8_title">The harbour</string>
    <string name="journey_8_flavor">Acey-deucey, the sailors\' game: every checker starts off the board and a 1-2 changes everything.</string>
    <string name="journey_8_opponent">The captain</string>
