<?xml version="1.0" encoding="utf-8"?>
<!-- Chapters arrive along the road rather than appearing all at once. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="260" />
    <translate
        android:fromXDelta="12%"
        android:toXDelta="0"
        android:duration="320" />
    <scale
        android:fromXScale="0.96"
        android:toXScale="1"
        android:fromYScale="0.96"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="320" />
</set>
