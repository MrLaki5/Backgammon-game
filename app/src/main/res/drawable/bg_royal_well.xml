<?xml version="1.0" encoding="utf-8"?>
<!-- A recess cut into the panel, for controls that are set in rather than raised. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:startColor="#3D2716"
                android:endColor="#1B1008"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/gold_hairline" />
        </shape>
    </item>
</layer-list>
