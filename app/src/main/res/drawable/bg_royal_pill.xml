<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only badge (wallet, rating): a sunken well rather than a raised button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <gradient
        android:angle="90"
        android:startColor="#432B18"
        android:endColor="#1E120A"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/gold_hairline" />
</shape>
