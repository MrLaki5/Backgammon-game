<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E6A100">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#2A4258"
                android:endColor="#152531"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3A5568" />
        </shape>
    </item>
</ripple>
