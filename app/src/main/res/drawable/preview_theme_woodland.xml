    <!-- Copper outlines on triangles (single combined path, stroke only) -->
    <path android:fillColor="#00000000"
          android:strokeColor="#B47834"
          android:strokeWidth="0.7"
          android:pathData="
            M8,8   L28,8  L18,86 Z M28,8  L48,8  L38,86 Z
            M48,8  L68,8  L58,86 Z M68,8  L88,8  L78,86 Z
            M88,8  L108,8 L98,86 Z M108,8 L128,8 L118,86 Z
            M8,172   L28,172  L18,94 Z M28,172  L48,172  L38,94 Z
            M48,172  L68,172  L58,94 Z M68,172  L88,172  L78,94 Z
            M88,172  L108,172 L98,94 Z M108,172 L128,172 L118,94 Z
            M140,8  L160,8  L150,86 Z M160,8  L180,8  L170,86 Z
            M180,8  L200,8  L190,86 Z M200,8  L220,8  L210,86 Z
            M220,8  L240,8  L230,86 Z M240,8  L260,8  L250,86 Z
            M140,172 L160,172 L150,94 Z M160,172 L180,172 L170,94 Z
            M180,172 L200,172 L190,94 Z M200,172 L220,172 L210,94 Z
            M220,172 L240,172 L230,94 Z M240,172 L260,172 L250,94 Z"/>

