                            M0,0 H8 V180 H0 Z
                            M264,0 H272 V180 H264 Z"/>

    <!-- LEFT QUADRANT: 6 top triangles (base y=8, tip y=86) -->
    <!-- Each point width: (264-8-8)/2 / 6 = 124/6 ≈ 20.7 → use 20 each, starts at x=8 -->
    <!-- Green at i=0,2,4; cream at i=1,3,5 -->
    <path android:fillColor="#2B5223"
          android:pathData="M8,8   L28,8  L18,86 Z
                            M48,8  L68,8  L58,86 Z
                            M88,8  L108,8 L98,86 Z"/>
