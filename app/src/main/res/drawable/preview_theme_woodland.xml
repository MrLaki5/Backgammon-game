          android:pathData="M28,8  L48,8  L38,86 Z
                            M68,8  L88,8  L78,86 Z
                            M108,8 L128,8 L118,86 Z"/>

    <!-- LEFT QUADRANT: 6 bottom triangles (base y=172, tip y=94) -->
    <!-- Inverted colors: cream at i=0,2,4; green at i=1,3,5 -->
    <path android:fillColor="#E8DDB5"
          android:pathData="M8,172   L28,172  L18,94 Z
                            M48,172  L68,172  L58,94 Z
                            M88,172  L108,172 L98,94 Z"/>
    <path android:fillColor="#2B5223"
          android:pathData="M28,172  L48,172  L38,94 Z
                            M68,172  L88,172  L78,94 Z
                            M108,172 L128,172 L118,94 Z"/>

    <!-- Center bar -->
    <path android:fillColor="#200E05"
          android:pathData="M132,8 H140 V172 H132 Z"/>

    <!-- RIGHT QUADRANT: same structure starting at x=140 -->
    <!-- top triangles: cream at 0,2,4; green at 1,3,5 (mirrored colors) -->
    <path android:fillColor="#E8DDB5"
          android:pathData="M140,8  L160,8  L150,86 Z
                            M180,8  L200,8  L190,86 Z
                            M220,8  L240,8  L230,86 Z"/>
    <path android:fillColor="#2B5223"
          android:pathData="M160,8  L180,8  L170,86 Z
                            M200,8  L220,8  L210,86 Z
                            M240,8  L260,8  L250,86 Z"/>

    <!-- bottom triangles: green at 0,2,4; cream at 1,3,5 -->
    <path android:fillColor="#2B5223"
          android:pathData="M140,172 L160,172 L150,94 Z
                            M180,172 L200,172 L190,94 Z
                            M220,172 L240,172 L230,94 Z"/>
