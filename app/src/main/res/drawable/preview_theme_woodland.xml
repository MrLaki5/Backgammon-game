    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Board background: dark walnut -->
    <path android:fillColor="#3B1C0A"
          android:pathData="M0,0 H272 V180 H0 Z"/>

    <!-- Frame overlay (border darkening) -->
