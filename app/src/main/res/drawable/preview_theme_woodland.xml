    <path android:fillColor="#261408"
          android:pathData="M276,8 H316 V86 H276 Z"/>
    <path android:fillColor="#00000000"
          android:strokeColor="#B47834"
          android:strokeWidth="1.5"
          android:pathData="M276,8 H316 V86 H276 Z"/>

