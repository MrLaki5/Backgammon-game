<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#CC88A5B7"
                android:startColor="#F0112532" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F0112532"
                android:startColor="#F0183242" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#99F4B044" />
        </shape>
    </item>
</selector>
