<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer gold border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#D4AF37" />
        </shape>
    </item>

    <!-- Inner dark gap (between double borders) -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#0E1721" />
        </shape>
    </item>

    <!-- Second inner gold border -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E6A100" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Main background fill -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E3347"
                android:centerColor="#162533"
                android:endColor="#0E1721"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
