<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gold border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#40E6A100" />
            <solid android:color="#0A0F14" />
        </shape>
    </item>

    <!-- Inner gradient fill -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="270"
                android:startColor="#1A2530"
                android:endColor="#0F1922"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
