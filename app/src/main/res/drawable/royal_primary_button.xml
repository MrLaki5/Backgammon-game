<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/accent_orange"
                android:startColor="@color/accent_gold" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/accent_gold"
                android:endColor="@color/accent_orange"
                android:startColor="@color/text_primary" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/accent_gold" />
        </shape>
    </item>
</selector>
